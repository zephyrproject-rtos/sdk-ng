CT_CONFIG_VERSION="3"
CT_EXPERIMENTAL=y
CT_ARCH_M68K=y
CT_ARCH_CPU="m68000"
CT_TARGET_CFLAGS="-ftls-model=local-exec"
CT_TARGET_VENDOR="zephyr"
CT_MULTILIB=y
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-gnu-ld --with-gnu-as --enable-initfini-array --with-arch=m68k"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--with-gnu-ld --with-gnu-as --enable-initfini-array --with-arch=m68k"
